{
  "expo": {
    "name": "Theodore Code",
    "slug": "theodore",
    "version": "0.1.35",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.theodore.mobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "associatedDomains": [
        "applinks:theodore.cloud",
        "applinks:staging.theodore.cloud"
      ]
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#3F86D6",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.theodore.mobile",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            { "scheme": "https", "host": "theodore.cloud", "pathPrefix": "/s/" },
            {
              "scheme": "https",
              "host": "staging.theodore.cloud",
              "pathPrefix": "/s/"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "defaultChannel": "default",
          "icon": "./assets/notification-icon.png",
          "color": "#3F86D6"
        }
      ],
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#F2F2F7",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-image",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "Theodore attaches the photos you pick to messages for the agent on your computer.",
          "cameraPermission": "Theodore sends the photos you take to the agent on your computer."
        }
      ],
      "expo-document-picker"
    ],
    "scheme": "theodore-mobile",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "067cf6ff-eec6-4ee6-8c5b-d82d2b2d23b9"
      }
    },
    "owner": "jean_i"
  }
}
