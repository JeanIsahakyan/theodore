#!/usr/bin/env bash
# qa <driver-dir> <js>: run <js> in the app, print {"ok":…} or {"err":…}.
# <js> is a function body (`return …`) with the helpers of lib.js in scope.
# Waits QA_WAIT tenths of a second (default 400, 40 s).
d="$1"; js="$2"; id="q$$_$RANDOM"
if [ ! -d "$d/in" ]; then
  echo '{"err":"no driver at '"$d"': is the app running?"}'; exit 1
fi
repo=null
if [[ ${THEODORE_QA_REPO:-} =~ ^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$ ]]; then
  repo="'$THEODORE_QA_REPO'"
fi
{
  printf 'const QA_REPO = %s;\n' "$repo"
  cat "$(dirname "$0")/lib.js"
  printf '%s\n' "$js"
} > "$d/in/$id.tmp" && mv "$d/in/$id.tmp" "$d/in/$id.js"
for _ in $(seq 1 "${QA_WAIT:-400}"); do
  if [ -f "$d/out/$id.json" ]; then
    cat "$d/out/$id.json"; echo; rm -f "$d/out/$id.json"; exit 0
  fi
  sleep 0.1
done
echo '{"err":"driver timeout"}'; exit 1
