{
  "pr": {
    "title": "Org-level limits for invoices, seats and API calls",
    "body": "Org-level limits for invoices, seats and API calls. `limit = null` means unlimited. Over the limit the API returns 402 and billing gets an email.",
    "commits": [
      "add OrgLimit table and LimitKind enum",
      "checkLimit + LimitExceededError",
      "record usage with kind",
      "rename countUsage -> count",
      "map LimitExceededError to 402",
      "limit-reached email",
      "index on UsageEvent(orgId, kind)"
    ]
  },
